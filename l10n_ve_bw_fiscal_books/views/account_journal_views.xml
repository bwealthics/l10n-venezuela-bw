<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_l10n_ve_channel" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ve.emission.channel</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="l10n_ve_emission_channel"
                       invisible="type not in ('sale', 'purchase')"/>
            </xpath>
        </field>
    </record>
</odoo>
