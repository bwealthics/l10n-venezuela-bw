<odoo>
    <record id="view_l10n_ve_paper_batch_list" model="ir.ui.view">
        <field name="name">l10n.ve.paper.batch.list</field>
        <field name="model">l10n.ve.paper.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="control_from"/>
                <field name="control_to"/>
                <field name="invoice_from" optional="show"/>
                <field name="invoice_to" optional="show"/>
                <field name="printer_name" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_paper_batch_form" model="ir.ui.view">
        <field name="name">l10n.ve.paper.batch.form</field>
        <field name="model">l10n.ve.paper.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Lote">
                            <field name="active" invisible="1"/>
                            <field name="type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Imprenta autorizada">
                            <field name="printer_name"/>
                            <field name="printer_vat"/>
                            <field name="printer_authorization"/>
                        </group>
                        <group string="Rango de Nº de control">
                            <field name="control_from"/>
                            <field name="control_to"/>
                        </group>
                        <group string="Rango de Nº de factura (talonario)"
                               invisible="type != 'talonario'">
                            <field name="invoice_from"/>
                            <field name="invoice_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_paper_batch" model="ir.actions.act_window">
        <field name="name">Papelería fiscal (VE)</field>
        <field name="res_model">l10n.ve.paper.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registre el talonario o la caja de formas libres
            </p>
            <p>
                Un registro por lote físico de la imprenta autorizada: de aquí
                salen la propuesta del siguiente correlativo en el POS, la
                validación de duplicados y el aviso de agotamiento.
            </p>
        </field>
    </record>

    <menuitem id="menu_l10n_ve_paper_batch"
              name="Papelería fiscal (VE)"
              parent="account.menu_finance_configuration"
              action="action_l10n_ve_paper_batch"
              groups="account.group_account_manager"
              sequence="90"/>
</odoo>
