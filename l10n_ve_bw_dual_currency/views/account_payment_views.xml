<odoo>
    <!-- Formulario de pago: tasa del asiento del pago y monto equivalente en Bs. -->
    <record id="view_account_payment_form_dual_currency" model="ir.ui.view">
        <field name="name">account.payment.form.dual.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="move_id" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="l10n_ve_bs_currency_id" invisible="1"/>
                <field name="l10n_ve_bs_rate" digits="[12,4]"
                       invisible="not move_id or not l10n_ve_bs_currency_id or l10n_ve_bs_currency_id == company_currency_id or not l10n_ve_bs_rate"/>
                <field name="l10n_ve_amount_bs"
                       invisible="not move_id or not l10n_ve_bs_currency_id or l10n_ve_bs_currency_id == company_currency_id or not l10n_ve_bs_rate"/>
            </xpath>
        </field>
    </record>

    <!-- Lista de pagos: monto Bs opcional (no almacenado: sin suma ni orden). -->
    <record id="view_account_payment_tree_dual_currency" model="ir.ui.view">
        <field name="name">account.payment.list.dual.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_company_currency_signed']" position="after">
                <field name="l10n_ve_bs_currency_id" column_invisible="True"/>
                <field name="l10n_ve_amount_bs" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
