<odoo>
    <!--
        Lista general de apuntes contables. Las variantes agrupadas (ventas,
        banco, varios, tercero, auditoría de impuestos) heredan de esta lista,
        así que reciben las columnas Bs automáticamente.
    -->
    <record id="view_move_line_tree_dual_currency" model="ir.ui.view">
        <field name="name">account.move.line.list.dual.currency</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_currency_id']" position="after">
                <field name="l10n_ve_bs_currency_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='credit']" position="after">
                <field name="l10n_ve_debit_bs" sum="Total Debe Bs" optional="show" readonly="1"
                       decoration-muted="l10n_ve_debit_bs == 0"/>
                <field name="l10n_ve_credit_bs" sum="Total Haber Bs" optional="show" readonly="1"
                       decoration-muted="l10n_ve_credit_bs == 0"/>
            </xpath>
            <xpath expr="//field[@name='balance']" position="after">
                <field name="l10n_ve_balance_bs" sum="Total Saldo Bs" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Pivote: el saldo en Bs como medida adicional (cuadra con el saldo en USD). -->
    <record id="view_move_line_pivot_dual_currency" model="ir.ui.view">
        <field name="name">account.move.line.pivot.dual.currency</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field name="l10n_ve_balance_bs" type="measure"/>
            </xpath>
        </field>
    </record>
</odoo>
