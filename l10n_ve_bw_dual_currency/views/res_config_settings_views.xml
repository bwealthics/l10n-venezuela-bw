<odoo>
    <!-- Se hereda la vista de invoice_format para colocar este bloque justo
         debajo del de "Comprobante" (misma sección de Localización Venezuela). -->
    <record id="res_config_settings_view_form_dual_currency" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ve.bw.dual.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_bw_invoice_format.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='l10n_ve_bw_document_block']" position="after">
                <block title="Localización Venezuela — Doble moneda"
                       name="l10n_ve_bw_dual_currency_block">
                    <setting id="l10n_ve_bw_line_amount_bs_setting"
                             company_dependent="1"
                             help="Añade al cuerpo del comprobante la columna «Importe Bs» por ítem, convertida con la tasa congelada del documento. Solo aparece si la moneda Bs de la sección «Comprobante» es distinta de la del documento.">
                        <field name="l10n_ve_show_line_amount_bs"/>
                    </setting>
                    <setting id="l10n_ve_bw_line_price_bs_setting"
                             company_dependent="1"
                             help="Añade junto al precio unitario la columna «Precio Bs». Apagado por defecto: el importe en Bs por línea suele bastar y el precio ensancha la tabla.">
                        <field name="l10n_ve_show_line_price_bs"/>
                    </setting>
                    <setting id="l10n_ve_bw_bs_rate_cutoff_setting"
                             company_dependent="1"
                             string="Hora de publicación de la tasa BCV"
                             help="Antes de esta hora (Caracas) se usa la tasa del día anterior; después se exige la del día para confirmar facturas y cobrar en el POS.">
                        <field name="l10n_ve_bs_rate_cutoff" widget="float_time"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
