<odoo>
    <!-- Todos los xpath están verificados contra
         odoo/19.0/addons/account/views/report_invoice.xml y contra
         l10n_ve_bw_invoice_format/report/report_invoice_ve.xml.

         Esta herencia se aplica DESPUÉS de la de invoice_format (mismo
         inherit_id, este módulo depende de él y su id es mayor): por eso
         puede anclarse en `ve_bs`, en las filas `l10n_ve_bs_*` y en la nota
         `l10n_ve_bs_rate_note` que esa herencia crea. Se hereda por posición
         (after/inside/attributes del nodo hoja), nunca reemplazando bloques
         completos del core, salvo la tabla de totales, que en modo dual pasa
         a tres columnas y no admite otra forma. -->
    <template id="report_invoice_document_dual"
              inherit_id="account.report_invoice_document">

        <!-- ================================================================
             Variables del modo dual
             `ve_bs` lo arma invoice_format llamando a `_l10n_ve_bs_amounts()`,
             que este módulo sobreescribe y marca con `dual: True` cuando los
             Bs salen de los campos ALMACENADOS (tasa congelada al confirmar),
             no de convertir otra vez al imprimir. Sin `dual` (sin tasa, o
             documento ya en Bs) `ve_bs` es {} y el PDF queda como el del core.
             ================================================================ -->
        <xpath expr="//t[@t-set='ve_bs']" position="after">
            <t t-set="ve_dual" t-value="bool(ve_bs and ve_bs.get('dual'))"/>
            <!-- Interruptores de la compañía: importe Bs (default sí) y precio
                 Bs (default no). Ambos exigen `ve_dual`: sin tasa no hay Bs
                 que imprimir y una columna vacía confunde más que no tenerla. -->
            <t t-set="ve_col_amount"
               t-value="ve_dual and o.company_id.l10n_ve_show_line_amount_bs"/>
            <t t-set="ve_col_price"
               t-value="ve_dual and o.company_id.l10n_ve_show_line_price_bs"/>
            <t t-set="ve_col_any" t-value="bool(ve_col_amount or ve_col_price)"/>
            <!-- Mismas opciones del widget monetario para todas las celdas Bs. -->
            <t t-set="ve_bs_opts"
               t-value="{'widget': 'monetary', 'display_currency': ve_bs['currency']} if ve_dual else {}"/>
            <!-- La columna de importe del core muestra el SUBTOTAL (sin
                 impuestos) cuando `company_price_include` es tax_excluded y el
                 TOTAL (con impuestos) cuando es tax_included, en la línea, en
                 las secciones y en las filas agrupadas. La columna Bs replica
                 exactamente esa misma regla para que ambas columnas sean la
                 misma cifra en dos monedas. -->
            <t t-set="ve_amount_included"
               t-value="o.company_price_include == 'tax_included'"/>
            <t t-set="ve_bs_field"
               t-value="'l10n_ve_price_total_bs' if ve_amount_included else 'l10n_ve_price_subtotal_bs'"/>
            <t t-set="ve_core_field"
               t-value="'price_total' if ve_amount_included else 'price_subtotal'"/>
        </xpath>

        <!-- ================================================================
             Tasa en el bloque de información
             `ve_bs` todavía no existe aquí (se define DESPUÉS de este bloque,
             junto a display_taxes), así que se invoca el método una vez más:
             es una lectura de campos almacenados, no una conversión.
             La etiqueta usa la moneda de la COMPAÑÍA porque la tasa guardada
             es "Bs por 1 unidad de la moneda de la compañía".
             ================================================================ -->
        <xpath expr="//div[@id='informations']" position="inside">
            <t t-set="ve_info" t-value="o._l10n_ve_bs_amounts()"/>
            <div class="col" name="l10n_ve_bs_rate_info"
                 t-if="ve_info and ve_info.get('dual')">
                <strong>Tasa BCV</strong>
                <div>
                    <span>1 </span><span t-out="o.company_id.currency_id.name">USD</span>
                    <span> = </span><span t-out="ve_info['rate']"
                                        t-options='{"widget": "float", "precision": 4}'>777,4161</span>
                    <span> </span><span t-out="ve_info['currency'].name">VES</span>
                </div>
                <div class="text-muted small">
                    del <span t-out="ve_info['date'].strftime('%d-%m-%Y')">20-08-2026</span>
                </div>
            </div>
        </xpath>

        <!-- ================================================================
             Encabezados de la tabla de líneas
             "Precio Bs" junto al precio unitario y "Importe Bs" a la derecha
             del importe del core. Las clases replican las del core para que en
             la vista HTML se oculten en móvil igual que las demás columnas.
             ================================================================ -->
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th name="th_l10n_ve_price_bs" t-if="ve_col_price"
                t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Precio Bs</span>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_l10n_ve_amount_bs" t-if="ve_col_amount" class="text-end text-nowrap">
                <span>Importe Bs</span>
            </th>
        </xpath>

        <!-- ================================================================
             Colspan de las filas de sección/subsección y agrupadas
             El nombre de la sección absorbe todas las columnas hasta el
             importe, de modo que cada columna nueva ANTES del importe (aquí
             "Precio Bs") obliga a crecer el colspan en 1; la de DESPUÉS
             ("Importe Bs") no, porque la fila sí recibe su propia celda.
             Se ancla al nodo con `name` (como hace invoice_format) y va
             después del t-set de éste: cada herencia suma lo suyo.
             ================================================================ -->
        <xpath expr="//t[@name='account_invoice_line_accountable']" position="before">
            <t t-set="line_colspan"
               t-value="line_colspan + (1 if ve_col_price else 0)"/>
        </xpath>

        <!-- ================================================================
             Línea de producto normal
             ================================================================ -->
        <xpath expr="//td[@name='td_price_unit']" position="after">
            <td name="td_l10n_ve_price_bs" t-if="ve_col_price"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="line.l10n_ve_price_unit_bs"
                      t-options="ve_bs_opts">9,00</span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="after">
            <td name="td_l10n_ve_amount_bs" t-if="ve_col_amount" class="text-end o_price_total">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="line[ve_bs_field]"
                      t-options="ve_bs_opts">27,00</span>
            </td>
        </xpath>

        <!-- ================================================================
             Fila de sección/subsección (rama sin colapsar)
             El core muestra `get_section_subtotal()` o `get_section_total()`
             (suma de las líneas hijas, directas e indirectas). Los Bs son la
             suma del mismo campo Bs sobre exactamente esas líneas
             (`_get_section_lines()`, el mismo método que usa el core), así que
             el total de la sección en Bs cuadra con la suma de sus líneas.
             ================================================================ -->
        <xpath expr="//t[@t-elif=&quot;line.display_type in ('line_section', 'line_subsection')&quot;]"
               position="inside">
            <td name="td_l10n_ve_section_amount_bs" t-if="ve_col_amount" colspan="1" class="text-end o_price_total">
                <span class="text-nowrap"
                      t-out="sum(line._get_section_lines().mapped(ve_bs_field))"
                      t-options="ve_bs_opts">27,00</span>
            </td>
        </xpath>

        <!-- ================================================================
             Rama agrupada (combos y secciones con composición/precios
             colapsados)
             Los dicts de `_get_child_lines()` NO exponen las líneas que
             agrupan: solo nombre, impuestos, subtotal, total, cantidad…
             Por eso el Bs se resuelve así:
               - Primer dict (índice 0): es la propia sección o la fila
                 colapsada, con la suma de TODAS sus líneas hijas. Su Bs es
                 la suma exacta de los Bs de esas líneas.
               - Demás dicts (subsecciones agrupadas por impuestos y líneas
                 hijas sueltas): se prorratean con el factor efectivo de la
                 sección (Bs hijas / USD hijas). Puede diferir un céntimo de
                 la suma de líneas por redondeo; es la limitación asumida
                 al no tener las líneas en el dict. Solo aparece en la
                 columna de importe cuando el core la imprime (sección,
                 subsección con precios visibles o fila colapsada).
             ================================================================ -->
        <xpath expr="//t[@t-set='grouped_lines']" position="after">
            <t t-set="ve_g_children"
               t-value="line._get_section_lines() if ve_col_any else o.env['account.move.line']"/>
            <t t-set="ve_g_bs_sum" t-value="sum(ve_g_children.mapped(ve_bs_field))"/>
            <t t-set="ve_g_core_sum" t-value="sum(ve_g_children.mapped(ve_core_field))"/>
            <!-- La celda de PRECIO del core imprime siempre el subtotal (sin
                 impuestos), aunque la de importe siga `company_price_include`.
                 Con precios IVA incluido ambos difieren, así que el precio Bs
                 necesita sus propias sumas basadas en el subtotal. -->
            <t t-set="ve_g_sub_bs_sum" t-value="sum(ve_g_children.mapped('l10n_ve_price_subtotal_bs'))"/>
            <t t-set="ve_g_sub_core_sum" t-value="sum(ve_g_children.mapped('price_subtotal'))"/>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name_grouped_desktop']" position="before">
            <t t-set="line_colspan"
               t-value="line_colspan + (1 if ve_col_price and not (hide_details or grouped_line['display_type'] == 'product') else 0)"/>
            <t t-set="ve_g_amount_bs"
               t-value="(ve_g_bs_sum if grouped_line_index == 0 else (ve_bs['currency'].round(grouped_line[ve_core_field] * ve_g_bs_sum / ve_g_core_sum) if ve_g_core_sum else 0.0)) if ve_col_any else 0.0"/>
            <!-- Bs de la columna de PRECIO: mismo criterio pero sobre el
                 subtotal, que es lo que imprime el core en esa celda. -->
            <t t-set="ve_g_price_bs"
               t-value="(ve_g_sub_bs_sum if grouped_line_index == 0 else (ve_bs['currency'].round(grouped_line['price_subtotal'] * ve_g_sub_bs_sum / ve_g_sub_core_sum) if ve_g_sub_core_sum else 0.0)) if ve_col_price else 0.0"/>
        </xpath>

        <xpath expr="//td[@name='td_price_unit_grouped']" position="after">
            <!-- Misma condición que la celda de precio del core: el core
                 imprime aquí el subtotal (sin impuestos) del grupo, así que se
                 imprime el Bs de ese subtotal, no el del importe. -->
            <td name="td_l10n_ve_price_bs_grouped" colspan="1"
                t-if="ve_col_price and (hide_details or grouped_line['display_type'] not in ('line_section', 'line_subsection'))"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="ve_g_price_bs"
                      t-options="ve_bs_opts">9,00</span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_subtotal_grouped']" position="after">
            <!-- Misma condición de visibilidad que el importe del core: solo
                 sección, subsección con precios visibles o fila colapsada. -->
            <td name="td_l10n_ve_amount_bs_grouped" colspan="1"
                t-if="ve_col_amount" class="text-end o_price_total">
                <span t-if="grouped_line.get('display_type') == 'line_section' or (not hide_prices and grouped_line.get('display_type') == 'line_subsection') or hide_details"
                      class="text-nowrap"
                      t-out="ve_g_amount_bs"
                      t-options="ve_bs_opts">27,00</span>
            </td>
        </xpath>

        <!-- ================================================================
             Tabla de totales de 3 columnas (concepto, moneda del documento, Bs)
             En modo dual se desactiva el `t-call` del core
             (account.document_tax_totals) y se dibuja el bloque propio:
             el core no deja intercalar una columna en su plantilla.
             Los montos del documento salen de `o.tax_totals` (lo mismo que
             imprime el core) y los Bs de `ve_bs`, calculados con la tasa
             congelada, de modo que ambas columnas cuadran entre sí.
             Solo se contempla el primer subtotal (base imponible): es lo que
             maneja la localización VE; un subtotal intermedio configurado a
             mano no tendría su Bs en `ve_bs`.
             ================================================================ -->
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="attributes">
            <attribute name="t-if">o.tax_totals and not ve_dual</attribute>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="after">
            <t t-if="o.tax_totals and ve_dual">
                <t t-set="ve_tt" t-value="o.tax_totals"/>
                <!-- Pagos del core: determina si el "Saldo pendiente" propio
                     se imprime o lo cubre la fila "Amount Due" del core. -->
                <t t-set="ve_payments"
                   t-value="print_with_payments and o.payment_state != 'invoicing_legacy' and (o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or [])"/>

                <tr name="l10n_ve_dual_head" class="text-muted small">
                    <td/>
                    <td class="text-end text-nowrap"><span t-out="o.currency_id.name">USD</span></td>
                    <td class="text-end text-nowrap"><span t-out="ve_bs['currency'].name">VES</span></td>
                </tr>

                <tr name="l10n_ve_dual_subtotal" class="o_subtotal" t-if="ve_bs['tax_groups']">
                    <td><span>Subtotal</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_tt['base_amount_currency']"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'>27.00</span>
                    </td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['untaxed']"
                              t-options="ve_bs_opts">16.500,00</span>
                    </td>
                </tr>

                <!-- Por grupo de impuesto: primero la base imponible y luego
                     el impuesto, como pide el libro de ventas. Un impuesto de
                     0 % o exento muestra su base y un impuesto en cero. -->
                <t t-foreach="ve_bs['tax_groups']" t-as="ve_tg">
                    <tr name="l10n_ve_dual_base" class="o_taxes">
                        <td><span>B.I. </span><span t-out="ve_tg['name']">IVA 16%</span></td>
                        <td class="text-end">
                            <span class="text-nowrap" t-out="ve_tg['base']"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'>27.00</span>
                        </td>
                        <td class="text-end">
                            <span class="text-nowrap" t-out="ve_tg['base_bs']"
                                  t-options="ve_bs_opts">16.500,00</span>
                        </td>
                    </tr>
                    <tr name="l10n_ve_dual_tax" class="o_taxes">
                        <td><span t-out="ve_tg['name']">IVA 16%</span></td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="ve_tg['tax']"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'>4.32</span>
                        </td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="ve_tg['tax_bs']"
                                  t-options="ve_bs_opts">2.640,00</span>
                        </td>
                    </tr>
                </t>

                <!-- Redondeo de efectivo: el core lo imprime entre impuestos y
                     total. En Bs es lo que sobra del total sobre base e
                     impuestos, para que la columna sume. -->
                <tr name="l10n_ve_dual_rounding" t-if="'cash_rounding_base_amount_currency' in ve_tt">
                    <td><span>Redondeo</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_tt['cash_rounding_base_amount_currency']"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'>0.00</span>
                    </td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['total'] - ve_bs['untaxed'] - ve_bs['tax']"
                              t-options="ve_bs_opts">0,00</span>
                    </td>
                </tr>

                <tr name="l10n_ve_dual_total" class="o_total border-black">
                    <td><strong>Total</strong></td>
                    <td class="text-end">
                        <strong class="text-nowrap" t-out="ve_tt['total_amount_currency']"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'>31.05</strong>
                    </td>
                    <td class="text-end">
                        <strong class="text-nowrap" t-out="ve_bs['total']"
                                t-options="ve_bs_opts">19.140,00</strong>
                    </td>
                </tr>

                <!-- Saldo pendiente: solo si dice algo (ni factura recién
                     emitida ni ya cobrada, regla de `show_residual`) y solo
                     cuando el core NO imprime ya su "Amount Due" (que sí
                     lleva cuando hay pagos listados), para no duplicarlo. -->
                <tr name="l10n_ve_dual_residual" class="fw-bold"
                    t-if="ve_bs['show_residual'] and not ve_payments">
                    <td><span>Saldo pendiente</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="o.amount_residual"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'>11.05</span>
                    </td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['residual']"
                              t-options="ve_bs_opts">9.570,00</span>
                    </td>
                </tr>
            </t>
        </xpath>

        <!-- ================================================================
             Filas de pagos del core, coherentes con las 3 columnas
             Cada fila del core trae 2 celdas. En modo dual se completa con una
             tercera: vacía en los pagos (el pago pudo hacerse a otra tasa y
             convertirlo con la del documento sería inventar una cifra) y con
             el saldo en Bs en "Amount Due", que sí es del documento.
             ================================================================ -->
        <xpath expr="//t[@t-foreach='payments_vals']/tr/td[hasclass('text-end')]" position="after">
            <td t-if="ve_dual"/>
        </xpath>
        <xpath expr="//t[@t-if='len(payments_vals) &gt; 0']//tr[hasclass('fw-bold')]" position="inside">
            <td t-if="ve_dual" class="text-end">
                <span class="text-nowrap" t-out="ve_bs['residual']"
                      t-options="ve_bs_opts">9.570,00</span>
            </td>
        </xpath>

        <!-- ================================================================
             Las 4 filas Bs de invoice_format (2 celdas, una sola columna de
             cifras) sobran en modo dual: la tabla de arriba ya trae los Bs.
             Se les añade/ajusta el `t-if` en lugar de borrarlas, para que sin
             el modo dual (sin tasa) sigan comportándose como antes.
             ================================================================ -->
        <xpath expr="//tr[@name='l10n_ve_bs_untaxed']" position="attributes">
            <attribute name="t-if">not ve_dual</attribute>
        </xpath>
        <xpath expr="//tr[@name='l10n_ve_bs_tax']" position="attributes">
            <attribute name="t-if">not ve_dual</attribute>
        </xpath>
        <xpath expr="//tr[@name='l10n_ve_bs_total']" position="attributes">
            <attribute name="t-if">not ve_dual</attribute>
        </xpath>
        <xpath expr="//tr[@name='l10n_ve_bs_residual']" position="attributes">
            <attribute name="t-if">ve_bs['show_residual'] and not ve_dual</attribute>
        </xpath>

        <!-- ================================================================
             Nota legal de la tasa
             Se reemplaza el texto de invoice_format (genérico) por uno que
             cita la base legal de convertir a la tasa del BCV: PA SNAT/2011/
             0071 art. 13 num. 14 (factura en moneda extranjera con su
             equivalente en bolívares), Ley del IVA art. 25 (base imponible en
             moneda extranjera a la tasa vigente) y Ley del BCV art. 128
             (tipo de cambio oficial). La tasa va con 4 decimales y su fecha.
             Se sustituye el div interior y no el bloque, para conservar el
             `t-if="ve_bs"` y la posición que fijó invoice_format.
             La puntuación va PEGADA al nodo que cierra cada tramo: QWeb
             conserva el espacio en blanco del XML y, partido en spans, el PDF
             saldría con "777,4161 VES , vigente al 20-08-2026 .".
             ================================================================ -->
        <xpath expr="//div[@name='l10n_ve_bs_rate_note']/div" position="replace">
            <div class="col-12" style="font-size:8pt;">
                Equivalente en bolívares calculado a la tasa de cambio del BCV: 1 <span t-out="o.company_id.currency_id.name">USD</span>
                = <span t-out="ve_bs['rate']"
                        t-options='{"widget": "float", "precision": 4}'>777,4161</span>
                <span t-out="ve_bs['currency'].name">VES</span>, vigente al
                <span t-out="ve_bs['date'].strftime('%d-%m-%Y')">20-08-2026</span>.
                Conforme a la Providencia Administrativa SNAT/2011/0071 (art. 13, num. 14),
                la Ley del IVA (art. 25) y la Ley del Banco Central de Venezuela (art. 128).
            </div>
        </xpath>
    </template>
</odoo>
