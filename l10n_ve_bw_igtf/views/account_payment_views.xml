<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.l10n.ve.bw.igtf</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="l10n_ve_igtf_move_id" invisible="1"/>
                <button name="button_open_l10n_ve_igtf_move" type="object"
                        class="oe_stat_button" icon="fa-bars"
                        invisible="not l10n_ve_igtf_move_id"
                        groups="account.group_account_user,account.group_account_readonly">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Asiento IGTF</span>
                    </div>
                </button>
            </div>
            <group name="main_group" position="after">
                <field name="l10n_ve_igtf_applies" invisible="1"/>
                <group string="IGTF" name="l10n_ve_igtf"
                       invisible="not l10n_ve_igtf_applies">
                    <field name="l10n_ve_igtf_amount"
                           readonly="state != 'draft'"/>
                    <field name="l10n_ve_igtf_manual"
                           readonly="state != 'draft'"
                           invisible="not l10n_ve_igtf_manual"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
