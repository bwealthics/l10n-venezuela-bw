<odoo>
    <record id="view_pos_pos_form_fiscal" model="ir.ui.view">
        <field name="name">pos.order.form.l10n.ve.fiscal.printer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Datos fiscales (máquina)" name="l10n_ve_fiscal"
                       invisible="not l10n_ve_fiscal_number">
                    <field name="l10n_ve_fiscal_number"/>
                    <field name="l10n_ve_fiscal_doc_type"/>
                    <field name="l10n_ve_fiscal_machine_serial"/>
                    <field name="l10n_ve_fiscal_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
