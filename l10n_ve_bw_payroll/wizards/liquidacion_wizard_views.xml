<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="liquidacion_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.liquidacion.wizard.form</field>
        <field name="model">l10n.ve.liquidacion.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="end_date"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="garantia"/>
                        <field name="prest_trim"/>
                        <field name="intereses"/>
                        <field name="retroactivo"/>
                        <field name="prest_extra"/>
                        <field name="vac_frac"/>
                        <field name="bvac_frac"/>
                        <field name="util_frac"/>
                        <field name="total" class="fw-bold"/>
                    </group>
                </group>
                <div class="text-muted">
                    El pago de la liquidación debe hacerse dentro de los 5 días
                    siguientes al término de la relación (art. 142.f LOTTT).
                </div>
                <footer>
                    <button name="action_create_payslip" type="object"
                            string="Crear recibo de liquidación" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_liquidacion_wizard" model="ir.actions.act_window">
        <field name="name">Finiquito / Liquidación (VE)</field>
        <field name="res_model">l10n.ve.liquidacion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
