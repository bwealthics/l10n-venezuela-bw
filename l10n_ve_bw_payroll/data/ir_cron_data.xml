<odoo>
    <data noupdate="1">
        <!-- Inactivo por defecto: el usuario lo activa cuando el flujo de
             provisiones esté validado. Solo CREA borradores; nunca postea. -->
        <record id="cron_ve_provision_monthly" model="ir.cron">
            <field name="name">Nómina VE: generar provisiones del mes (borrador)</field>
            <field name="model_id" ref="model_l10n_ve_payroll_provision"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
