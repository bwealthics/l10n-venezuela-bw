<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ve.bw.einvoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Localización Venezuela — Imprenta Digital"
                       name="l10n_ve_bw_edoc_block">
                    <setting id="l10n_ve_bw_edoc_setting"
                             string="Conexión con la imprenta digital"
                             company_dependent="1"
                             help="Credenciales del proveedor autorizado que asigna el Nº de control (PA SNAT/2024/000102). Solo se usa en los diarios cuyo canal de emisión es 'Imprenta digital'.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="l10n_ve_edoc_provider" string="Proveedor" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_provider"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ve_edoc_url" string="URL" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_url"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ve_edoc_user" string="Usuario" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_user"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ve_edoc_password" string="Clave" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_password" password="True"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ve_edoc_serie" string="Serie / sucursal" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_serie"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ve_edoc_test" string="Ambiente de pruebas" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ve_edoc_test"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
