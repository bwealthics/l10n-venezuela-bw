<odoo>
    <record id="view_l10n_ve_edoc_log_list" model="ir.ui.view">
        <field name="name">l10n.ve.edoc.log.list</field>
        <field name="model">l10n.ve.edoc.log</field>
        <field name="arch" type="xml">
            <list string="Bitácora de la imprenta digital" create="false">
                <field name="create_date" string="Fecha y hora"/>
                <field name="move_id"/>
                <field name="endpoint"/>
                <field name="ok" widget="boolean_toggle" readonly="1"/>
                <field name="create_uid" string="Usuario"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_edoc_log_form" model="ir.ui.view">
        <field name="name">l10n.ve.edoc.log.form</field>
        <field name="model">l10n.ve.edoc.log</field>
        <field name="arch" type="xml">
            <form string="Llamada a la imprenta digital" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="move_id"/>
                        <field name="endpoint"/>
                        <field name="ok"/>
                        <field name="create_date" string="Fecha y hora"/>
                        <field name="create_uid" string="Usuario"/>
                    </group>
                    <group string="Enviado">
                        <field name="request" nolabel="1"/>
                    </group>
                    <group string="Respuesta">
                        <field name="response" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_edoc_log" model="ir.actions.act_window">
        <field name="name">Bitácora de la imprenta digital</field>
        <field name="res_model">l10n.ve.edoc.log</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <menuitem id="menu_l10n_ve_edoc_log"
              name="Bitácora de la imprenta digital"
              parent="account.menu_finance_reports"
              action="action_l10n_ve_edoc_log"
              groups="account.group_account_invoice"
              sequence="90"/>
</odoo>
