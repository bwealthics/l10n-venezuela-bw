<odoo>
    <!-- Todos los xpath están verificados contra
         odoo/19.0/addons/account/views/report_invoice.xml. Se hereda por
         posición (after/inside/replace del nodo hoja), nunca reemplazando
         bloques completos del core. -->
    <template id="report_invoice_document_ve"
              inherit_id="account.report_invoice_document">

        <!-- Fecha (y hora, si se conoce) en el formato del art. 7.6.
             Se sustituye el nodo hoja de la fecha, no el bloque: el rótulo y
             la columna del core se conservan. Fuera de Venezuela el helper
             no se invoca porque la plantilla solo se instala en la
             localización VE. -->
        <xpath expr="//div[@name='invoice_date']/div[@t-field='o.invoice_date']"
               position="replace">
            <div t-out="o._l10n_ve_legal_datetime()">25-07-2026 03.14.07 p.m</div>
        </xpath>

        <!-- Nº de control asignado por la imprenta autorizada (art. 7.11) y
             su fecha de asignación (art. 7.15). -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" name="l10n_ve_control_number"
                 t-if="o.l10n_ve_control_number">
                <strong>Nº de Control</strong>
                <div t-out="o.l10n_ve_control_number">00-00001234</div>
            </div>
            <div class="col" name="l10n_ve_control_date"
                 t-if="o.l10n_ve_control_date">
                <strong>Asignación del Nº de Control</strong>
                <div t-out="o.l10n_ve_control_date.strftime('%d-%m-%Y')">25-07-2026</div>
            </div>
        </xpath>

        <!-- Marca (E) de exentas, exoneradas y no sujetas, junto a la
             descripción. La norma admite ponerla junto a la descripción o
             junto al precio; se elige la descripción por ser la columna que
             no se corta en los formatos angostos. -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <span t-if="line._l10n_ve_is_exempt()" class="fw-bold"> (E)</span>
        </xpath>

        <!-- Variables del bloque venezolano, junto a las display_* del core y
             ANTES de la tabla de líneas: así son visibles tanto en el cuerpo
             como en el pie, que es donde se usa `ve_bs`. Ambas se calculan una
             sola vez por documento. -->
        <xpath expr="//t[@t-set='display_taxes']" position="after">
            <t t-set="display_ve_tax_detail"
               t-value="display_taxes and o.company_id.l10n_ve_show_line_tax_detail and o.is_sale_document(include_receipts=True)"/>
            <t t-set="ve_bs" t-value="o._l10n_ve_bs_amounts()"/>
        </xpath>

        <!-- Monto sin impuestos e impuesto por ítem. Van ANTES de la columna
             de importe para que el ojo lea base → impuesto → total, y solo en
             documentos de venta: la factura de proveedor la imprime el
             proveedor, no nosotros. -->
        <xpath expr="//th[@name='th_subtotal']" position="before">
            <th name="th_l10n_ve_untaxed" t-if="display_ve_tax_detail"
                t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Sin impuestos</span>
            </th>
            <th name="th_l10n_ve_tax" t-if="display_ve_tax_detail"
                t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Impuesto</span>
            </th>
        </xpath>

        <!-- Las filas de sección y subsección no llevan las dos celdas nuevas
             (viven dentro de la rama `is_product`), así que su colspan tiene
             que crecer en 2 o el subtotal de la sección se desalinea. El t-set
             se ancla al nodo con `name`, no a la posición, para no depender
             del orden de los t-set del core. -->
        <xpath expr="//t[@name='account_invoice_line_accountable']" position="before">
            <t t-set="line_colspan"
               t-value="line_colspan + (2 if display_ve_tax_detail else 0)"/>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="before">
            <td name="td_l10n_ve_untaxed" t-if="display_ve_tax_detail"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-field="line.price_subtotal">27.00</span>
            </td>
            <td name="td_l10n_ve_tax" t-if="display_ve_tax_detail"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="line.price_total - line.price_subtotal"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'>4.32</span>
            </td>
        </xpath>

        <!-- Mismo par de celdas en la rama de líneas agrupadas (combos y
             líneas con composición colapsada). Se replican las condiciones del
             core para td_discount_grouped, y el colspan crece solo en las
             filas que NO reciben celda. -->
        <xpath expr="//td[@name='account_invoice_line_name_grouped_desktop']" position="before">
            <t t-set="line_colspan"
               t-value="line_colspan + (2 if display_ve_tax_detail and not (hide_details or grouped_line['display_type'] == 'product') else 0)"/>
        </xpath>

        <xpath expr="//td[@name='td_subtotal_grouped']" position="before">
            <td name="td_l10n_ve_untaxed_grouped" colspan="1"
                t-if="display_ve_tax_detail and (hide_details or grouped_line['display_type'] == 'product')"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="grouped_line['price_subtotal']"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'>27.00</span>
            </td>
            <td name="td_l10n_ve_tax_grouped" colspan="1"
                t-if="display_ve_tax_detail and (hide_details or grouped_line['display_type'] == 'product')"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="not hide_prices" class="text-nowrap"
                      t-out="grouped_line['price_total'] - grouped_line['price_subtotal']"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'>4.32</span>
            </td>
        </xpath>

        <!-- Equivalente en bolívares, dentro de la MISMA tabla de totales: el
             monto en Bs va junto al total, no en un anexo. Se añade al final
             para quedar bajo el total y los pagos del core. -->
        <xpath expr="//table[hasclass('o_total_table')]" position="inside">
            <t t-if="ve_bs">
                <tr class="border-black o_total" name="l10n_ve_bs_untaxed">
                    <td><span>Monto sin impuestos en Bs</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['untaxed']"
                              t-options='{"widget": "monetary", "display_currency": ve_bs["currency"]}'>16.500,00</span>
                    </td>
                </tr>
                <tr name="l10n_ve_bs_tax">
                    <td><span>Impuestos en Bs</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['tax']"
                              t-options='{"widget": "monetary", "display_currency": ve_bs["currency"]}'>2.640,00</span>
                    </td>
                </tr>
                <tr class="fw-bold" name="l10n_ve_bs_total">
                    <td><span>Total en Bs</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['total']"
                              t-options='{"widget": "monetary", "display_currency": ve_bs["currency"]}'>19.140,00</span>
                    </td>
                </tr>
                <tr t-if="ve_bs['show_residual']" class="fw-bold" name="l10n_ve_bs_residual">
                    <td><span>Saldo pendiente en Bs</span></td>
                    <td class="text-end">
                        <span class="text-nowrap" t-out="ve_bs['residual']"
                              t-options='{"widget": "monetary", "display_currency": ve_bs["currency"]}'>9.570,00</span>
                    </td>
                </tr>
            </t>
        </xpath>

        <!-- Datos de la imprenta autorizada (art. 7.14) y rango asignado.
             La norma exige ≥6pt para la imprenta; 8pt queda holgado. -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-3" name="l10n_ve_printer_block"
                 t-if="o.company_id.l10n_ve_printer_name">
                <div class="col-12" style="font-size:8pt;">
                    <span>Imprenta autorizada: </span>
                    <span t-field="o.company_id.l10n_ve_printer_name">Imprenta, C.A.</span>
                    <span t-if="o.company_id.l10n_ve_printer_vat">
                        — RIF <span t-field="o.company_id.l10n_ve_printer_vat">J-00000000-0</span>
                    </span>
                    <span t-if="o.company_id.l10n_ve_printer_auth_number">
                        — Providencia Nº <span t-field="o.company_id.l10n_ve_printer_auth_number">SNAT/2024/0000</span>
                    </span>
                    <span t-if="o.company_id.l10n_ve_printer_auth_date">
                        del <span t-out="o.company_id.l10n_ve_printer_auth_date.strftime('%d-%m-%Y')">01-01-2025</span>
                    </span>
                    <span t-if="o.company_id.l10n_ve_control_range_from and o.company_id.l10n_ve_control_range_to">
                        — Rango de Nº de control asignado:
                        <span t-field="o.company_id.l10n_ve_control_range_from">00-00000001</span>
                        al <span t-field="o.company_id.l10n_ve_control_range_to">00-00005000</span>
                    </span>
                </div>
            </div>
        </xpath>

        <!-- Nota de la tasa, SIEMPRE que se imprima el bloque en Bs: sin ella
             el equivalente en bolívares no es verificable. Se ancla al bloque
             de la imprenta —y no otra vez a #total— para que el orden no
             dependa de en qué orden se apliquen los xpath. No se rotula la
             fuente ("BCV") porque cuál moneda es la de referencia lo decide la
             configuración; el nombre de la moneda y la fecha sí son ciertos
             siempre. -->
        <xpath expr="//div[@name='l10n_ve_printer_block']" position="before">
            <div class="row mt-2" name="l10n_ve_bs_rate_note" t-if="ve_bs">
                <!-- La puntuación va PEGADA al nodo que cierra cada tramo (sin
                     salto de línea intermedio): QWeb conserva el espacio en
                     blanco del XML y, partido en spans, el PDF salía con
                     "777,4161 VES , vigente al 20-08-2026 .". -->
                <div class="col-12" style="font-size:8pt;">
                    Tasa de cambio aplicada: 1 <span t-out="o.currency_id.name">USD</span>
                    = <span t-out="ve_bs['rate']"
                            t-options='{"widget": "float", "precision": 4}'>777,4161</span>
                    <span t-out="ve_bs['currency'].name">VES</span>, vigente al
                    <span t-out="ve_bs['date'].strftime('%d-%m-%Y')">20-08-2026</span>.
                    Los montos en bolívares se expresan convertidos a esa tasa.
                </div>
            </div>
        </xpath>
    </template>
</odoo>
