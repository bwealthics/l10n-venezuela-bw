<odoo>
    <record id="view_l10n_ve_municipal_tax_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.municipal.tax.wizard.form</field>
        <field name="model">l10n.ve.municipal.tax.wizard</field>
        <field name="arch" type="xml">
            <form string="Impuesto Municipal (VE)">
                <field name="is_computed" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="ves_currency_id" invisible="1"/>
                <group>
                    <group string="Período">
                        <field name="company_id" groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                    <group string="Configuración">
                        <field name="municipality"/>
                        <field name="rate"/>
                        <field name="minimum_mmv" string="Mínimo (veces MMV)"/>
                        <field name="tcmmv" string="TCMMV (Bs)"/>
                    </group>
                </group>
                <group string="Cálculo" invisible="not is_computed">
                    <group>
                        <field name="base_amount"/>
                        <field name="computed_tax"/>
                    </group>
                    <group>
                        <field name="minimum_amount"/>
                        <field name="tax_amount" class="fw-bold"/>
                        <!-- Oculto si no hay tasa BCV real cargada (amount_bs = 0):
                             nunca mostrar el monto USD etiquetado como Bs. -->
                        <field name="amount_bs" invisible="not amount_bs"/>
                    </group>
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Calcular"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_generate_entry" type="object" string="Generar Asiento"
                            class="btn-primary" invisible="not is_computed"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_municipal_tax_wizard" model="ir.actions.act_window">
        <field name="name">Impuesto Municipal (VE)</field>
        <field name="res_model">l10n.ve.municipal.tax.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Mismo grupo que la ACL del wizard (implicado por basic/user/manager). -->
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Cuelga de account.menu_finance (visible para group_account_invoice):
         account.menu_finance_entries exige group_account_readonly, que en 19.0
         NO está implicado por group_account_invoice, y ocultaba el menú justo
         al grupo al que la ACL da acceso. -->
    <menuitem id="menu_l10n_ve_municipal_tax_wizard"
              name="Impuesto Municipal (VE)"
              parent="account.menu_finance"
              action="action_l10n_ve_municipal_tax_wizard"
              groups="account.group_account_invoice"
              sequence="15"/>
</odoo>
