<templates id="template" xml:space="preserve">
    <!-- Total en Bs y tasa BCV justo debajo del Total del recibo, dentro del
         bloque que el core oculta en la pre-cuenta (basic_receipt). -->
    <t t-name="l10n_ve_bw_dual_currency_pos.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <t t-set="bsReceipt" t-value="l10nVeBsReceipt"/>
            <t t-if="bsReceipt">
                <div class="pos-receipt-amount l10n-ve-bs-total fw-bolder">
                    <span class="label-total-bs">Total Bs</span>
                    <span t-out="bsReceipt.total" class="pos-receipt-right-align font-monospace"/>
                </div>
                <div class="l10n-ve-bs-rate text-start" style="font-size: 85%;">
                    Tasa BCV: <span class="font-monospace" t-out="bsReceipt.rate"/>
                    <t t-if="bsReceipt.date">(<t t-out="bsReceipt.date"/>)</t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
